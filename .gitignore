# Extracted full text of the Imagine rulebooks.
#
# Kept local, never committed. Permission to build and publish a Foundry conversion is not
# permission to republish the books themselves, and this repository is public -- committing
# them would put the complete text of four commercial titles where anyone can read them.
#
# Regenerate from the PDFs when needed:
#     python tools/extract/extract_book_text.py <book.pdf> <name>
docs/reference/players-guide-fulltext.txt
docs/reference/masters-manual-fulltext.txt
docs/reference/aspects-of-the-wild-fulltext.txt
docs/reference/mysteries-of-the-planes-fulltext.txt

# Source PDFs, if they ever land inside the working tree.
*.pdf

# Python bytecode from the extraction tooling.
__pycache__/
*.pyc

# Per-developer Claude Code settings. The shared settings file is .claude/settings.json;
# the .local one holds one person's own permission grants and is not the project's business.
.claude/settings.local.json

# Local test-server config: the port changes every run.
.claude/launch.json

# The built system zip. The folder beside it IS committed -- it is the deliverable -- but the
# archive is regenerated from it and would be a new binary blob on every build.
dist/*.zip
